{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HOMI Debug",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "flutterMode": "debug",
      "templateFor": "lib",
