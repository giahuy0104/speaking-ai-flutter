<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds only allow HTTPS, except to the in-app loopback server that
  StreamedWavSource serves streamed WAV speech from (http://127.0.0.1:<port>).
  Debug builds remove this file in src/debug/AndroidManifest.xml and keep
  usesCleartextTraffic="true".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
